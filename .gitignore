# Build artifacts
build/
generated/
.cpmcache/

# tt-metal build output inside the submodule (the source is tracked by
# the submodule pointer; its build tree is a local artifact).
third_party/tt-metal/build_*/

# tools/export_*.py download cache (CIFAR-10 tarball, pretrained checkpoints…)
.cache/

# Example and model kernel build outputs (per-dir prebuilt/)
examples/*/prebuilt/
models/*/prebuilt/
ops/*/prebuilt/
bench/prebuilt_noBread/

# Editor / OS noise
*.swp
.DS_Store
# Local Claude config is ignored, except checked-in project skills under
# .claude/skills/ that are meant to be shared with the team.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/tt-umd-update/

# Model data — regenerated by each model's export.py script
data/resnet20/
# Qwen3 layer dumps — regenerated by models/qwen3_vl_2b/export_qwen3_layer.py
data/qwen3_06b/
data/qwen3_vl_2b/
